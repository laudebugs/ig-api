{"info": {"description": "Instagram Graph API — runnable requests mirroring openapi.yaml. Set collection variables before running: graph_host, graph_version, ig_user_id, access_token, media_id, comment_id.", "name": "Instagram Graph API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"}, "item": [{"description": "Profile, Page linkage, oEmbed.", "item": [{"name": "Get IG user profile", "request": {"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{ig_user_id}}"], "query": [{"key": "fields", "value": "id,username,account_type,media_count,followers_count"}]}}}, {"name": "Resolve IG ID from Page", "request": {"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{page_id}}"], "query": [{"key": "fields", "value": "instagram_business_account{id,username}"}]}}}, {"name": "oEmbed public post", "request": {"method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "instagram_oembed"], "query": [{"key": "url", "value": "{{post_url}}"}, {"key": "fields", "value": "author_name,provider_name,html,thumbnail_url"}]}}}], "name": "Identity"}, {"description": "Two-step publish: create container, poll status for video, publish.", "item": [{"name": "Create photo container", "request": {"body": {"mode": "urlencoded", "urlencoded": [{"key": "image_url", "value": "{{image_url}}"}, {"key": "caption", "value": "Hello from the API #launch"}, {"key": "access_token", "value": "{{access_token}}"}]}, "method": "POST", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{ig_user_id}}", "media"]}}}, {"name": "Create Reels container", "request": {"body": {"mode": "urlencoded", "urlencoded": [{"key": "media_type", "value": "REELS"}, {"key": "video_url", "value": "{{video_url}}"}, {"key": "caption", "value": "New reel"}, {"key": "share_to_feed", "value": "true"}, {"key": "access_token", "value": "{{access_token}}"}]}, "method": "POST", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{ig_user_id}}", "media"]}}}, {"name": "Poll container status", "request": {"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{container_id}}"], "query": [{"key": "fields", "value": "status_code,status"}]}}}, {"name": "Publish container", "request": {"body": {"mode": "urlencoded", "urlencoded": [{"key": "creation_id", "value": "{{container_id}}"}, {"key": "access_token", "value": "{{access_token}}"}]}, "method": "POST", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{ig_user_id}}", "media_publish"]}}}, {"name": "Check publishing quota", "request": {"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{ig_user_id}}", "content_publishing_limit"], "query": [{"key": "fields", "value": "quota_usage,rate_limit_settings,config"}]}}}, {"name": "Update caption", "request": {"body": {"mode": "urlencoded", "urlencoded": [{"key": "caption", "value": "Edited caption"}, {"key": "access_token", "value": "{{access_token}}"}]}, "method": "POST", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{media_id}}"]}}}, {"name": "Delete media", "request": {"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "method": "DELETE", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{media_id}}"]}}}], "name": "Publishing"}, {"description": "Media, stories, carousel children.", "item": [{"name": "List media", "request": {"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{ig_user_id}}", "media"], "query": [{"key": "fields", "value": "id,caption,media_type,media_product_type,permalink,timestamp"}, {"key": "limit", "value": "25"}]}}}, {"name": "Get media object", "request": {"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{media_id}}"], "query": [{"key": "fields", "value": "id,caption,media_type,media_product_type,permalink,timestamp,like_count,comments_count"}]}}}, {"name": "List stories", "request": {"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{ig_user_id}}", "stories"], "query": [{"key": "fields", "value": "id,media_type,timestamp"}]}}}], "name": "Media"}, {"description": "Account, media, story insights.", "item": [{"name": "Account insights", "request": {"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{ig_user_id}}", "insights"], "query": [{"key": "metric", "value": "reach,impressions,profile_views"}, {"key": "period", "value": "day"}]}}}, {"name": "Media insights", "request": {"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{media_id}}", "insights"], "query": [{"key": "metric", "value": "reach,impressions,engagement,saved"}]}}}], "name": "Insights"}, {"description": "List, reply, hide, delete.", "item": [{"name": "List comments", "request": {"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{media_id}}", "comments"], "query": [{"key": "fields", "value": "id,text,username,timestamp,like_count,hidden"}]}}}, {"name": "Reply to comment", "request": {"body": {"mode": "urlencoded", "urlencoded": [{"key": "message", "value": "Thanks! More coming Friday."}, {"key": "access_token", "value": "{{access_token}}"}]}, "method": "POST", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{comment_id}}", "replies"]}}}, {"name": "Hide comment", "request": {"body": {"mode": "urlencoded", "urlencoded": [{"key": "hide", "value": "true"}, {"key": "access_token", "value": "{{access_token}}"}]}, "method": "POST", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{comment_id}}"]}}}, {"name": "Delete comment", "request": {"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "method": "DELETE", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{comment_id}}"]}}}], "name": "Comments"}, {"description": "DMs within the 24h window; conversations.", "item": [{"name": "Send text message", "request": {"body": {"mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"recipient\": { \"id\": \"{{igsid}}\" },\n  \"messaging_type\": \"RESPONSE\",\n  \"message\": { \"text\": \"Hi! Your order ships Friday.\" }\n}"}, "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}, {"key": "Content-Type", "value": "application/json"}], "method": "POST", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{ig_user_id}}", "messages"]}}}, {"name": "List conversations", "request": {"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{ig_user_id}}", "conversations"], "query": [{"key": "platform", "value": "instagram"}, {"key": "fields", "value": "id,participants,updated_time"}]}}}], "name": "Messaging"}, {"description": "Hashtag search, top/recent media, business discovery.", "item": [{"name": "Hashtag search", "request": {"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "ig_hashtag_search"], "query": [{"key": "user_id", "value": "{{ig_user_id}}"}, {"key": "q", "value": "paris2026"}]}}}, {"name": "Recent hashtag media", "request": {"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{hashtag_id}}", "recent_media"], "query": [{"key": "user_id", "value": "{{ig_user_id}}"}, {"key": "fields", "value": "id,caption,permalink,timestamp,like_count"}]}}}, {"name": "Mentioned media", "request": {"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{ig_user_id}}", "mentioned_media"], "query": [{"key": "fields", "value": "id,caption,permalink"}]}}}, {"name": "Tagged media", "request": {"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{ig_user_id}}", "tags"], "query": [{"key": "fields", "value": "id,caption,permalink"}, {"key": "limit", "value": "25"}]}}}], "name": "Discovery"}, {"description": "Token exchange, debug, webhook subscription.", "item": [{"name": "Code to short-lived token", "request": {"method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "oauth", "access_token"], "query": [{"key": "client_id", "value": "{{app_id}}"}, {"key": "client_secret", "value": "{{app_secret}}"}, {"key": "redirect_uri", "value": "{{redirect_uri}}"}, {"key": "code", "value": "{{oauth_code}}"}]}}}, {"name": "Exchange for long-lived token", "request": {"method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "oauth", "access_token"], "query": [{"key": "grant_type", "value": "fb_exchange_token"}, {"key": "client_id", "value": "{{app_id}}"}, {"key": "client_secret", "value": "{{app_secret}}"}, {"key": "fb_exchange_token", "value": "{{access_token}}"}]}}}, {"name": "Debug token", "request": {"method": "GET", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "debug_token"], "query": [{"key": "input_token", "value": "{{access_token}}"}, {"key": "access_token", "value": "{{app_id}}|{{app_secret}}"}]}}}, {"name": "Subscribe webhooks", "request": {"body": {"mode": "urlencoded", "urlencoded": [{"key": "subscribed_fields", "value": "comments,messages,mentions"}, {"key": "access_token", "value": "{{access_token}}"}]}, "method": "POST", "url": {"host": ["{{graph_host}}"], "path": ["{{graph_version}}", "{{page_id}}", "subscribed_apps"]}}}], "name": "Auth and Webhooks"}], "variable": [{"key": "graph_host", "value": "https://graph.facebook.com"}, {"key": "graph_version", "value": "v25.0"}, {"key": "ig_user_id", "value": "17841400008460056"}, {"key": "access_token", "value": "EAAB..."}, {"key": "media_id", "value": "17987654321098765"}, {"key": "container_id", "value": "17901234567890123"}, {"key": "comment_id", "value": "178700001"}, {"key": "page_id", "value": "109876543210"}, {"key": "hashtag_id", "value": "17841500000000000"}, {"key": "igsid", "value": "IGSID_FROM_WEBHOOK"}, {"key": "image_url", "value": "https://example.com/photo.jpg"}, {"key": "video_url", "value": "https://example.com/reel.mp4"}, {"key": "post_url", "value": "https://www.instagram.com/p/SHORTCODE/"}, {"key": "app_id", "value": ""}, {"key": "app_secret", "value": ""}, {"key": "redirect_uri", "value": ""}, {"key": "oauth_code", "value": ""}]}
